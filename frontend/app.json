{
  "expo": {
    "name": "AgroPay",
    "slug": "agropay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroPay usa tu galería para adjuntar una foto del producto.",
          "cameraPermission": "AgroPay puede usar la cámara si quieres tomar una foto del producto."
        }
      ]
    ]
  }
}
